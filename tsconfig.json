{
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "types": ["bun-types"],
    "noEmit": true
  },
  "include": ["server.ts", "release-app.ts", "src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts"]
}
